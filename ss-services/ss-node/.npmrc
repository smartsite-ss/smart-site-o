# Hoist @nestjs and typeorm to root node_modules to ensure single instance
# This prevents DI token mismatch (class reference !==) caused by pnpm duplication
public-hoist-pattern[]=@nestjs/typeorm
public-hoist-pattern[]=@nestjs/core
public-hoist-pattern[]=@nestjs/common
public-hoist-pattern[]=@nestjs/config
public-hoist-pattern[]=@nestjs/event-emitter
public-hoist-pattern[]=typeorm

# Disable pnpm self-managed version switching (packageManager pin fails with
# EPERM creating node_global\.tools on this machine); use global pnpm directly
manage-package-manager-versions=false