{
  "name": "ss-node-server",
  "version": "0.1.0",
  "private": true,
  "description": "Smart SCADA Node Server Main Application",
  "scripts": {
    "prebuild": "node scripts/generate-build-info.cjs",
    "build": "node -e \"try{require('fs').unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\" && nest build --tsc",
    "typecheck": "tsc --noEmit",
    "dev": "node -e \"try{require('fs').unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\" && nest build --tsc --watch",
    "start": "node --require reflect-metadata dist/main",
    "start:dev": "set NODE_ENV=development && set NODE_OPTIONS=--require reflect-metadata && nest start --tsc --watch",
    "start:debug": "set NODE_ENV=development && set NODE_OPTIONS=--require reflect-metadata && nest start --tsc --debug --watch",
    "start:prod": "set APP_ENV=pro && node --require reflect-metadata dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^3.0.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.3.0",
    "@ss-node/ss-alarm": "workspace:*",
    "@ss-node/ss-collector-modbus": "workspace:*",
    "@ss-node/ss-collector-mqtt": "workspace:*",
    "@ss-node/ss-collector-opcua": "workspace:*",
    "@ss-node/ss-collector-s7": "workspace:*",
    "@ss-node/ss-collector-sdk": "workspace:*",
    "@ss-node/ss-collector-virtual": "workspace:*",
    "@ss-node/ss-core": "workspace:*",
    "@ss-node/ss-datasource": "workspace:*",
    "@ss-node/ss-datatag": "workspace:*",
    "@ss-node/ss-device": "workspace:*",
    "@ss-node/ss-i18n": "workspace:*",
    "@ss-node/ss-project": "workspace:*",
    "@ss-node/ss-report": "workspace:*",
    "@ss-node/ss-script": "workspace:*",
    "@ss-node/ss-sdk": "workspace:*",
    "@ss-node/ss-storage-influx": "workspace:*",
    "@ss-node/ss-storage-influx3": "workspace:*",
    "@ss-node/ss-storage-tdengine": "workspace:*",
    "@ss-node/ss-system": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "nest-winston": "^1.9.4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.2",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.17",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  }
}
