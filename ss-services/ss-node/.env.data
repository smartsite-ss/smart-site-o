# ===========================================
# Smart SCADA - ss-data 拆分模式
# 仅数据中台/系统管理（共享 + data 模块）
# 路径变量（DATA_DIR/TEMPLATES_DIR/DICTS_DIR 等）已移至 .env.base
# 此处仅配置 data 专有项
# ===========================================

# 产品模式
APP_PRODUCT_MODE=data

# 应用配置
NODE_ENV=development
# 端口（与集成模式一致，因为集成模式不会同时运行）
PORT=4000

# 日志目录（覆盖 .env.base 默认值，使用硬编码路径避免跨文件展开问题）
LOG_DIR=../../ss-run/ss/data/logs-data

# InfluxDB 时序数据库配置
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=mQnRp60FIvAnNUiQzr2KGYRAy0Amz9Fr0_jQBfma0YArbAeTsqxMXhlFoo2Ua1EMb5IXrnxMFhOZwtz1oBnrNw==
INFLUXDB_ORG=ss-org
INFLUXDB_BUCKET=ss_node_data
INFLUXDB_BATCH_SIZE=1000
INFLUXDB_FLUSH_INTERVAL=5000

# MQTT 配置
MQTT_BROKER_URL=mqtt://localhost:1883

# OPC UA 配置
OPCUA_SERVER_URL=opc.tcp://localhost:4840

# Modbus 配置
MODBUS_TCP_HOST=localhost
MODBUS_TCP_PORT=502

# 注意：data 模式不配置 PLUGIN_CONFIG_DIR / TEMPLATES_DIR / DICTS_DIR
# 这些变量由 scada 模式或集成模式（full）加载
