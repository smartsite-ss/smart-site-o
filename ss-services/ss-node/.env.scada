# ===========================================
# Smart SCADA - ss-scada 拆分模式
# 仅组态编辑器/运行器（共享 + scada 模块）
# 路径变量（DATA_DIR/TEMPLATES_DIR/DICTS_DIR 等）已移至 .env.base
# 此处仅配置 scada 专有项
# ===========================================

# 产品模式
APP_PRODUCT_MODE=scada

# 应用配置
NODE_ENV=development
# 端口（避免与 ss-data 拆分模式冲突）
PORT=4100

# 日志目录（覆盖 .env.base 默认值，使用硬编码路径避免跨文件展开问题）
LOG_DIR=../../ss-run/ss/data/logs-scada

# 注意：scada 模式不配置 InfluxDB / MQTT / OPCUA / Modbus / KB_*
# 这些变量由 ss-data 模式或集成模式（full）加载
