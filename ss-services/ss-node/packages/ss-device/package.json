{
  "name": "@ss-node/ss-device",
  "version": "0.1.0",
  "private": true,
  "description": "Smart SCADA Device Management Library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.3.0",
    "@ss-node/ss-core": "workspace:*",
    "@ss-node/ss-collector-sdk": "workspace:*",
    "@ss-node/ss-datatag": "workspace:*",
    "@ss-node/ss-i18n": "workspace:*",
    "@ss-node/ss-sdk": "workspace:*",
    "@ss-node/ss-system": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.20"
  }
}
