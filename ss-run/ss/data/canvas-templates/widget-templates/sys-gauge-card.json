{
  "id": "sys-gauge-card",
  "name": "仪表盘卡",
  "description": "指针仪表 + 标题，支持 {{title}}/{{value}}/{{unit}} 变量（value 为数值）",
  "category": "gauge",
  "author": "system",
  "source": "builtin",
  "schemaVersion": 2,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "graphics": [
    {
      "type": "group",
      "id": "g",
      "name": "仪表盘卡",
      "x": 0,
      "y": 0,
      "width": 240,
      "height": 190,
      "children": [
        {
          "type": "rect",
          "id": "bg",
          "x": 0,
          "y": 0,
          "width": 240,
          "height": 190,
          "props": {
            "fill": "#0f2542",
            "stroke": "#1e3a5f",
            "strokeWidth": 1,
            "cornerRadius": 8
          }
        },
        {
          "type": "text",
          "id": "title",
          "x": 20,
          "y": 12,
          "width": 200,
          "height": 22,
          "props": {
            "text": "{{title}}",
            "fontSize": 14,
            "fontWeight": "bold",
            "fill": "#e8eef7"
          }
        },
        {
          "type": "chart-gauge",
          "id": "gauge",
          "x": 40,
          "y": 40,
          "width": 160,
          "height": 130,
          "props": {
            "value": "{{value}}",
            "minValue": 0,
            "maxValue": 100,
            "unit": "{{unit}}",
            "warningValue": 80,
            "dangerValue": 90,
            "showTicks": true,
            "showValue": true,
            "backgroundColor": "#00000000",
            "borderColor": "#1e3a5f",
            "titleColor": "#e8eef7",
            "labelColor": "#93a3b8",
            "valueColor": "#e8eef7",
            "tickColor": "#64748b"
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "key": "title",
      "label": "仪表名称",
      "type": "text",
      "defaultValue": "管网压力"
    },
    {
      "key": "value",
      "label": "当前值",
      "type": "number",
      "defaultValue": 56
    },
    {
      "key": "unit",
      "label": "单位",
      "type": "text",
      "defaultValue": "kPa"
    }
  ],
  "tags": [
    "仪表",
    "gauge"
  ],
