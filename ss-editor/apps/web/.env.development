VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# ====== 调试模式：跳过认证（仅开发环境生效） ======
# ⚠️  debug-mock-token 仅在后端 NODE_ENV !== 'production' 时被识别
#     生产构建时此文件不会被加载
VITE_DEBUG_SKIP_AUTH=false

# ====== 部署基础路径 ======
# 为空时（dev 模式）：directory 插件通过 @fs 协议加载源码
# 有值时（prod 模式）：插件和共享依赖均从此路径派生
# 例如 / → 插件路径=/plugins, 共享依赖路径=/shared
VITE_DEPLOY_BASE=

# ====== 插件双模配置 ======
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins

# 预加载的行业分类（逗号分隔）
# 注意：仅列出 deployMode=directory 的分类（见 packages/plugins/categories.json）
# bundled 分类的图元已编译进主包，无需在此列出，否则会请求不存在的 directory manifest
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,svg

