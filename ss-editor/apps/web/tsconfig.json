{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@scada-editor/core": ["../../packages/core/src/index.ts"],
      "@scada-editor/editor": ["../../packages/editor/src/index.ts"],
      "@scada-editor/system": ["../../packages/system/src/index.ts"],
      "@scada-editor/plugins-*": ["../../packages/plugins/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "../../packages/plugins/scripts/virtual-modules.d.ts"]
}