# Smart SCADA - ss-scada 拆分模式
# 仅组态编辑器/运行态
VITE_PRODUCT_MODE=scada
VITE_API_BASE_URL=http://localhost:4100
VITE_WS_URL=http://localhost:4100

# dev server 端口：scada 模式固定 5174，严禁占用 5173（full 壳端口，含 /preview）
VITE_PORT=5174

# 部署基础路径（拆分模式下可使用子路径）
VITE_DEPLOY_BASE=/

# 插件双模配置
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,3d,svg

# 跨产品跳转 URL（data 模式前端地址，用于从 scada 跳转到 data）
VITE_DATA_BASE_URL=http://localhost:5175
