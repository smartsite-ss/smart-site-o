# ⚠️  此文件为生产构建配置，严禁添加 VITE_DEBUG_SKIP_AUTH=true
#     debug-mock-token 在生产环境后端不识别（jwt-auth.guard.ts isDevMode()=false）
#     调试认证开关请在 .env.development 中设置
#VITE_API_BASE_URL=https://api.example.com
#VITE_WS_URL=https://api.example.com
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# ====== 部署基础路径 ======
# 为空时（dev 模式）：directory 插件通过 @fs 协议加载源码
# 有值时（prod 模式）：插件和共享依赖均从此路径派生
# 例如 / → 插件路径=/plugins, 共享依赖路径=/shared
VITE_DEPLOY_BASE=/

# ====== 插件双模配置 ======
VITE_PLUGIN_MODE=mixed

# 远程插件 Registry 地址（生产环境指向 CDN）
#VITE_PLUGIN_REGISTRY_URL=https://cdn.example.com/plugins
VITE_PLUGIN_REGISTRY_URL=/plugins

# 预加载的行业分类（逗号分隔）
# 注意：仅列出 deployMode=directory 的分类（见 packages/plugins/categories.json）
# bundled 分类的图元已编译进主包，无需在此列出，否则会请求不存在的 directory manifest
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,svg