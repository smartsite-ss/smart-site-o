# Smart SCADA - 集成模式（full）
# 包含 ss-scada + ss-data 全部能力
# ⚠️  此文件仅用于生产构建，禁止包含任何调试开关（如 VITE_DEBUG_SKIP_AUTH）
#     调试开关请在 .env.development 中设置
#     参阅: jwt-auth.guard.ts isDevMode() — 生产环境不识别 mock token
VITE_PRODUCT_MODE=full
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# 部署基础路径
VITE_DEPLOY_BASE=/

# 插件双模配置
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,svg
