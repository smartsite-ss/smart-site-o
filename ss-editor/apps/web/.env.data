# Smart SCADA - ss-data 拆分模式
# 仅数据中台/系统管理
VITE_PRODUCT_MODE=data
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# dev server 端口：data 模式固定 5175，严禁占用 5173（full 壳端口，含 /preview）
VITE_PORT=5175

# 部署基础路径（拆分模式下可使用子路径）
VITE_DEPLOY_BASE=/

# 插件模式（data 模式不需要图元插件）
VITE_PLUGIN_MODE=off

# 跨产品跳转 URL（scada 模式前端地址，用于从 data 跳转到 scada 编辑器）
VITE_SCADA_BASE_URL=http://localhost:5174
