{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@scada-editor/core": ["./src/index.ts"],
      "@scada-editor/plugin-sdk": ["../plugin-sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "../plugin-sdk/src/**/*.d.ts"]
}