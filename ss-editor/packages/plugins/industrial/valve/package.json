{
  "name": "@scada-editor/plugins-industrial-valve",
  "version": "0.1.0",
  "description": "Valve graphic plugin for SCADA editor",
  "main": "./dist/index.mjs",
  "types": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./ValveConfig": {
      "import": "./ValveConfig.vue",
      "types": "./ValveConfig.vue"
    },
    "./ValveIcon": {
      "import": "./ValveIcon.vue",
      "types": "./ValveIcon.vue"
    }
  },
  "dependencies": {
    "vue": "^3.3.4",
    "@scada-editor/core": "workspace:*",
